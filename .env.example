# ==========================================================
# Ricas Papas Mary - variables de entorno (SIN secretos reales)
# ==========================================================

# Desarrollo local
DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# Base de datos (usa DATABASE_URL en producción o POSTGRES_* localmente)
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cloudinary - opción A: URL completa
CLOUDINARY_URL=

# Cloudinary - opción B: tres variables separadas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (si se utiliza)
GOOGLE_MAPS_API_KEY=

# Correo (si se utiliza SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
